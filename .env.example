# Copy to .env and fill in. The pipeline loads this automatically.
# .env is git-ignored — keep every real credential and personal detail in it, never
# in config.yaml or the source tree (both are committed).

# Subscription auth for headless Claude (generate with: claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# IMPORTANT: Do NOT set ANTHROPIC_API_KEY here or in your environment.
# If it is set, Claude Code uses per-token API billing instead of your subscription.
# ANTHROPIC_API_KEY=   <-- leave unset

# SEC EDGAR fair-access policy wants a contact address in the User-Agent of every
# request (src/news.py uses it for the 8-K feed). Put YOUR address here — SEC
# throttles anonymous callers more aggressively, so 8-K data degrades without it.
SEC_CONTACT_EMAIL=

# NOTE: IBKR credentials are NOT read from here. The Gateway logs itself in via IBC,
# which keeps them in C:\IBC\config.ini (outside this repo, and not committed). See
# the "Security" section of README.md for the setup, and keep ReadOnlyApi=yes.
